{
  "expo": {
    "name": "HyGrow",
    "slug": "HyGrow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "farmhelp",
    "userInterfaceStyle": "dark",
    "plugins": [
  "expo-router",
  "expo-font",
  "expo-web-browser",
  [
    "expo-splash-screen",
    {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    }
  ],
  "expo-status-bar"
],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmhelp.app",
      "icon": "./assets/images/icon.png",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.farmhelp.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6dc147d2-3731-463d-b4f0-bb0dc696cf76"
      }
    }
  }
}
