{
  "expo": {
    "name": "HyGrow",
    "slug": "hygrow-root",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hygrow-icon.png",
    "scheme": "farmhelp",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/hygrow-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmhelp.app",
      "icon": "./assets/images/hygrow-icon.png",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "icon": "./assets/images/hygrow-icon.png",
      "package": "com.prithvi.hygrow",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/hygrow-icon.png"
      },
      "runtimeVersion": "1.0.0"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0F172A"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/hygrow-icon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf94f005-a95e-4186-bac2-65e639a12229"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/cf94f005-a95e-4186-bac2-65e639a12229"
    }
  }
}
